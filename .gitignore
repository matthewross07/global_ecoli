# Ignore large binary feather files
*.feather

# Derived cache for the down-sampling analysis (rebuilt from the feather)
.cache_nearlydaily.rds

# R session history and user files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Temporary and log files
*.log
*.txt
temp.feather
*.swp

# Legacy / non-analysis files kept out of the archive
misc/

# Platform-owned paths. Code Ocean populates /data from attached data assets,
# writes /results during a run, and maintains .codeocean/ itself -- it does not
# check any of them out from git. Tracking a file under them therefore creates a
# permanent phantom deletion in the capsule: git says the file should exist, the
# capsule never materializes it, and the resulting "uncommitted changes" state
# blocks pushes via a server-side hook. Verified by re-cloning: a brand-new
# capsule shows .codeocean/environment.json as deleted from its first moment.
# Leave all three to the platform. The leading slashes keep paper_stats/data/
# tracked.
/data/
/results/
.codeocean/
out/
